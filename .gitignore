# Python virtual environment — never commit
venv/
env/
.venv/

# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Libra runtime artifacts — local audit logs
.libra/
*.log

# Streamlit secrets
.streamlit/secrets.toml

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Local model files
*.gguf
*.bin

# Test documents (sample contracts) — keep out of the repo
test_documents_docx/

# Scratch
*.tmp
~$*
